# Reference projects kept locally, not part of this repo
sample-projects/
*.zip

# .NET
bin/
obj/
.vs/
*.user
*.suo

# Dev runtime (pidfiles, logs) — see run-app.ps1 / tools/dev-mcp
.run/
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Node (client/ and tools/dev-mcp/ have their own, this catches the rest)
node_modules/

# Build output of the site template. The template's own lockfile IS committed: every site installs from it,
# and the sandbox image prebakes exactly those dependencies so a cold workspace does not npm install.
templates/*/.next/
templates/*/out/

# Playwright MCP scratch output (snapshots, console logs, screenshots)
.playwright-mcp/

# Local secrets / env
.env
.env.*
appsettings.*.local.json
