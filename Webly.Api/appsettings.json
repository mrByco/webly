{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Key and RefreshKey are deliberately absent: they are secrets, supplied by the environment in
  // production and by appsettings.Development.json locally. Startup validation fails loudly if a
  // deployment forgets them.
  "Jwt": {
    "Issuer": "webly",
    "Audience": "webly"
  },
  // Where this deployment answers. Links in mail, and the endpoint a published site's contact form posts
  // back to, are both built from it — one fact, one setting, never the request's Host header.
  "App": {
    "BaseUrl": "https://localhost:5000"
  },
  "Email": {
    // Resend:ApiKey is a secret and lives in user secrets / the environment. Without it the app
    // logs emails instead of sending them, which is exactly what local development wants.
    "FromName": "Webly",
    "FromAddress": "no-reply@webly.local"
  },
  // Every site is published at {slug}.<BaseDomain>. Overridden per environment.
  "Sites": {
    "BaseDomain": "webly.site",
    "MaxSitesPerUser": 3
  },
  // One bare git repository per site. A volume in production (see deploy/portainer-stack.yml); .run/ locally, which
  // is gitignored — a developer's sites are their own.
  "Repositories": {
    "Root": ".run/repositories"
  },
  // The Next.js project every new site starts as. A path, so it stays a normal project somebody can open and build.
  "Templates": {
    "SitePath": "templates/next-site"
  },
  // Where the coding agents run.
  //
  // "local" by default, which spawns tools/sandbox-agent as a child process confined to its workspace by
  // bubblewrap, with no network but an allow-list: it needs node, git and bwrap, so a fresh clone can edit a site
  // immediately. Selecting it outside Development is refused at startup — see LocalSandboxProvider. "docker" is the
  // same contract in a container for anyone who has a daemon (a filesystem boundary, not yet a network one); "e2b"
  // is production, configured in appsettings.Production.json.
  //
  // IdleTimeout is the number that decides what an idle editor costs, because a sandbox bills by the second.
  "Sandbox": {
    "Provider": "local",
    "Image": "byc0/margareta:webly_sandbox",
    "IdleTimeout": "00:10:00",
    "MaxLifetime": "02:00:00",
    "Local": {
      "AgentPath": "tools/sandbox-agent/index.js",
      // Empty: a directory of this checkout's own under the system temp directory. Never somewhere inside a git
      // repository — a coding agent walks up from its workspace looking for one, and found Webly's when this was
      // .run/workspaces. See LocalSandboxOptions.ResolveWorkspaceRoot.
      "WorkspaceRoot": "",
      // The agent sees its workspace and nothing else of this machine (bubblewrap; Linux). Without bubblewrap the
      // provider refuses to start rather than run unconfined — install it, or use the "docker" provider. "none"
      // turns confinement off, deliberately and visibly — and is the only way the local provider runs on Windows.
      "Confinement": "bubblewrap",
      // Where a confined sandbox may connect. Everything else is refused; empty means the defaults in
      // LocalSandboxOptions.DefaultEgress, which are these.
      "EgressAllow": [ "api.anthropic.com", "api.openai.com", "models.opencode.ai", "registry.npmjs.org", "fonts.googleapis.com", "fonts.gstatic.com" ],
      // A Chromium for the agent's self-review screenshots. Empty finds one on PATH; none means no screenshots.
      "Browser": "",
      // Set false to keep a workspace after a turn and look at what the agent actually wrote.
      "DeleteWorkspaceOnStop": true
    }
  },
  // Agent:ClaudeCode:ApiKey / Agent:OpenCode:ApiKey are secrets and live in user secrets / the environment.
  //
  // The mock agent is on here so that a clone with no keys at all still has a working chat: it makes one real,
  // deterministic edit, which is enough to exercise the workspace, the commit, the version, the preview and the
  // publish. The registry prefers Default when it is configured, so adding a real key takes over without a
  // setting change. It is off in appsettings.Production.json, deliberately.
  "Agent": {
    "Default": "claude-code",
    "Model": "claude-opus-5",
    "Mock": {
      "Enabled": true
    }
  },
  // Publishing. "filesystem" locally, which runs the same real `next build` as the publish gate and then writes
  // the static export to .run/published/{slug}, served at https://localhost:5000/published/{slug}/ — so a
  // publish ends at a page you can open without a hosting account. Deployment:Vercel:Token is a secret and lives
  // in user secrets; set Provider to "vercel" once it is there.
  "Deployment": {
    "Provider": "filesystem",
    "FileSystem": {
      "Root": ".run/published",
      "BaseUrl": "https://localhost:5000"
    },
    "Vercel": {
      "ProjectPrefix": "webly"
    }
  },
  "ConnectionStrings": {
    "WeblyDb": "Host=localhost;Port=5434;Database=webly;Username=webly;Password=webly"
  },
  "ReverseProxy": {
    "Routes": {
      "frontend-catch-all": {
        "ClusterId": "frontend",
        "Match": {
          "Path": "/{**catch-all}"
        },
        // Off here as well as in production, for the same two reasons and one more. The Angular server has
        // no use for them — the browser reaches this app at one origin and every URL the client builds is
        // relative — and trusting them instead would be worse, since YARP appends to an inbound
        // X-Forwarded-Host and the engine reads the first value. The extra reason is development's own:
        // left on, `ng serve` logs three "trustProxyHeaders was not set up to allow it" warnings per
        // request, which is most of what ends up in .run/frontend.log.
        "Transforms": [
          {
            "X-Forwarded": "Off"
          }
        ]
      }
    },
    "Clusters": {
      "frontend": {
        "Destinations": {
          "frontend-ssr": {
            "Address": "http://localhost:4000/"
          }
        }
      }
    }
  }
}
