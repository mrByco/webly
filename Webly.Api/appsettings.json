{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Key and RefreshKey are deliberately absent: they are secrets, supplied by the environment in
  // production and by appsettings.Development.json locally. Startup validation fails loudly if a
  // deployment forgets them.
  "Jwt": {
    "Issuer": "webly",
    "Audience": "webly"
  },
  "Email": {
    // Resend:ApiKey is a secret and lives in user secrets / the environment. Without it the app
    // logs emails instead of sending them, which is exactly what local development wants.
    "FromName": "Webly",
    "FromAddress": "no-reply@webly.local",
    "BaseUrl": "https://localhost:5000"
  },
  // Every site is published at {slug}.<BaseDomain>. Overridden per environment; the value here is what a local
  // stack renders canonical URLs with, so a rendered page in development looks exactly like a published one.
  "Sites": {
    "BaseDomain": "webly.site",
    "MaxSitesPerUser": 3
  },
  // Deployment:Vercel:Token is a secret and lives in user secrets / the environment. Without it the app still boots
  // and still edits sites; publishing is what fails, loudly, at startup validation.
  "Deployment": {
    "Vercel": {
      "ProjectPrefix": "webly"
    }
  },
  // Agent:*:ApiKey are secrets too. With neither provider configured the editor agent is absent rather than broken —
  // see AddAgentClients.
  "Agent": {},
  "ConnectionStrings": {
    "WeblyDb": "Host=localhost;Port=5434;Database=webly;Username=webly;Password=webly"
  },
  "ReverseProxy": {
    "Routes": {
      "frontend-catch-all": {
        "ClusterId": "frontend",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "frontend": {
        "Destinations": {
          "frontend-ssr": {
            "Address": "http://localhost:4000/"
          }
        }
      }
    }
  }
}
