# Build context for Webly.Api/Dockerfile is the repository root, because Central Package
# Management puts the package versions in Directory.Packages.props up here and every csproj
# in the solution is restored together. That means the client, the reference projects and the
# local dev runtime would all be shipped to the daemon unless they are excluded here.

client/
sample-projects/
design/
ds-bundle/

# tools/ is not excluded wholesale: deploy/sandbox/Dockerfile builds from this same context and the
# sandbox agent lives in tools/sandbox-agent. Only the dev-only MCP server is dropped.
tools/dev-mcp/

# templates/ is deliberately NOT excluded. Both images need it: the API creates a site's first commit
# from the template's files, and the sandbox image pre-installs its dependencies. The 370 MB of
# node_modules under it is handled by the **/node_modules/ rule below.

**/bin/
**/obj/
**/node_modules/

.git/
.github/
.run/
.vs/
.angular/
.claude/
.playwright-mcp/

*.zip
*.user
*.suo

# Never let a local secret file reach the image.
.env
.env.*
**/appsettings.*.local.json
