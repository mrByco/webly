# Normalize to LF in the repository, check out native. Without this, files written on Windows land
# with CRLF and every later diff on another machine shows the whole file as changed.
* text=auto

# Scripts that only ever run on Windows keep CRLF in the working tree.
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Shell scripts must keep LF even when checked out on Windows.
*.sh text eol=lf

# The sandbox agent's commands are shell scripts with no extension, and they reach the sandbox image as they are in
# the working tree: with CRLF, `#!/bin/sh\r` names an interpreter that does not exist and `webly-screenshot` fails
# inside every image built from a Windows checkout. Their .cmd twins are the Windows ones and keep CRLF.
tools/sandbox-agent/bin/* text eol=lf
tools/sandbox-agent/bin/*.cmd text eol=crlf

# Generated by ng-openapi-gen from the backend's swagger — committed so CI needs no backend, but
# never hand-edited. Collapsed in GitHub diffs and excluded from language stats.
client/src/app/api/** linguist-generated=true

# Generated by `dotnet ef migrations add`. Reviewable, but not hand-written.
Webly.Data/Migrations/** linguist-generated=true

*.png binary
*.ico binary
