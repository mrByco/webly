{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prestart": "run-script-os",
    "prestart:default": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx ng-openapi-gen --config open-api-gen.json",
    "prestart:windows": "set NODE_TLS_REJECT_UNAUTHORIZED=0&& npx ng-openapi-gen --config open-api-gen.json",
    "regen-api": "run-script-os",
    "regen-api:default": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx ng-openapi-gen --config open-api-gen.json",
    "regen-api:windows": "set NODE_TLS_REJECT_UNAUTHORIZED=0&& npx ng-openapi-gen --config open-api-gen.json",
    "build": "ng build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr": "node dist/client/server/server.mjs"
  },
  "private": true,
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.7",
    "@microsoft/signalr": "^10.0.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "daisyui": "^5.7.28",
    "jsdom": "^28.0.0",
    "ng-openapi-gen": "^1.0.5",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "run-script-os": "^1.1.6",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
